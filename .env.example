# Copy this file to .env locally, or set these environment variables.
# Only .env is loaded; this example is never loaded automatically.
# Base URL should include the provider's API prefix (often /v1), without /chat/completions.
DEEPSEEK_API_KEY=replace-locally
OPSLENS_MODEL=deepseek-flash
# Only needed with --provider compatible:
# OPSLENS_BASE_URL=https://your-provider.example/v1
# OPSLENS_API_KEY=replace-locally
